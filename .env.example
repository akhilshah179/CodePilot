# Copy to .env (never commit .env). The server reads it at startup.

# Public origin of the web app. OAuth callbacks go to <APP_ORIGIN>/api/auth/<provider>/callback.
# In development Vite serves the app on :5175 and proxies /api to the server on :8787.
APP_ORIGIN=http://localhost:5175
PORT=8787

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: http://localhost:5175/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (identity only — it never grants repository access)
# Authorized redirect URI: http://localhost:5175/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Encrypts OAuth tokens at rest. Required in production.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Local development only (ignored when NODE_ENV=production): sign in with a personal token
# instead of OAuth, e.g. DEV_GITHUB_TOKEN=$(gh auth token) npm run dev
# DEV_GITHUB_TOKEN=

# Optional limits
# MAX_REPO_SIZE_MB=1024
# CLONE_TIMEOUT_MS=300000
# ANALYSIS_CONCURRENCY=2
# DATA_DIR=.data

# Collective Intelligence (opt-in, per project). Thresholds can be raised, never lowered below
# the built-in floors (N >= 10, cell >= 3). Reviewers are GitHub logins or user ids allowed to
# approve or reject discovered patterns.
# COLLECTIVE_MIN_N=20
# COLLECTIVE_MIN_CELL=5
# COLLECTIVE_REVIEWERS=
